# Django Platform Configuration
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-helpdesk-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database Configuration
# Option 1: Complete connection string via DATABASE_URL (Recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intelligent_helpdesk

# Option 2: Individual database parameters (Used if DATABASE_URL is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=intelligent_helpdesk
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
